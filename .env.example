# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Project Settings > Database
# DATABASE_URL uses the pooled connection (port 6543, pgbouncer=true)
# DIRECT_URL uses the direct connection (port 5432), required for migrations
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# Cloudflare R2 — R2 Object Storage > (bucket) > Manage API tokens
# Bucket stays private; videos are served via short-lived presigned URLs (see lib/storage.ts).
# Uploads also PUT directly from the browser to R2 (bypassing the server, since
# hosts like Vercel cap request bodies well under video file sizes), so the
# bucket's CORS policy must allow that origin — run this once per environment:
#   npm run storage:configure-cors -- https://your-app.vercel.app http://localhost:3000
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google Cloud Console > APIs & Services > Credentials
# OAuth Client ID (Web application), with an authorized redirect URI of
# {APP_URL}/api/platforms/youtube/callback — enable the YouTube Data API v3
# and add test users under the OAuth consent screen while it's in Testing mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base URL used to build the OAuth redirect_uri, e.g. http://localhost:3000
# On Vercel, set this to your stable production domain (custom domain, or the
# project's *.vercel.app domain) in the Production environment variables —
# every OAuth redirect URI registered with Google/Meta below is pinned to
# whatever this resolves to, and preview-deployment URLs won't match them.
APP_URL=http://localhost:3000

# 32-byte key, base64-encoded, used to AES-256-GCM encrypt stored OAuth
# tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Random secret used to HMAC-sign the OAuth `state` param for CSRF
# protection. Generate with: openssl rand -base64 32
OAUTH_STATE_SECRET=

# developers.facebook.com — Business-type app with two products added:
#   1. "Instagram" (API setup with Instagram login) — no linked Facebook Page
#      required. Its account must be a Creator/Business (Professional) account.
#   2. "Facebook Login for Business" — for the Facebook Pages flow.
# Add yourself as an Admin/Developer/Tester on the app so the real OAuth flow
# works without waiting on App Review.
META_APP_ID=
META_APP_SECRET=
# Redirect URIs are derived from APP_URL above (same pattern as YouTube), not
# a separate env var — register both of these exactly in the Meta dashboard:
#   Instagram product > "OAuth redirect URIs":
#     {APP_URL}/api/platforms/instagram/callback
#   Facebook Login for Business product > "Valid OAuth Redirect URIs":
#     {APP_URL}/api/platforms/facebook/callback

# Instagram > API setup with Instagram login (App Dashboard). This is a
# SEPARATE App ID/Secret pair from META_APP_ID/META_APP_SECRET above — using
# the main App ID here causes Instagram's OAuth dialog to fail with
# "Invalid platform app".
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=

# Facebook Login for Business > Configurations > Create a Configuration.
# Since 2023 this product requires a Login Configuration (permissions bundled
# together) instead of a plain OAuth `scope` param — select pages_show_list,
# pages_manage_posts, and pages_read_engagement, using a User access token
# (not Page, since fetchFacebookPages() derives page tokens from it).
META_FACEBOOK_CONFIG_ID=
