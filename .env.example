# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Project Settings > Database
# DATABASE_URL uses the pooled connection (port 6543, pgbouncer=true)
# DIRECT_URL uses the direct connection (port 5432), required for migrations
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[HOST]:5432/postgres"

# Cloudflare R2 — R2 Object Storage > (bucket) > Manage API tokens
# Bucket stays private; videos are served via short-lived presigned URLs (see lib/storage.ts)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Google Cloud Console > APIs & Services > Credentials
# OAuth Client ID (Web application), with an authorized redirect URI of
# {APP_URL}/api/platforms/youtube/callback — enable the YouTube Data API v3
# and add test users under the OAuth consent screen while it's in Testing mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base URL used to build the OAuth redirect_uri, e.g. http://localhost:3000
APP_URL=http://localhost:3000

# 32-byte key, base64-encoded, used to AES-256-GCM encrypt stored OAuth
# tokens at rest. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Random secret used to HMAC-sign the OAuth `state` param for CSRF
# protection. Generate with: openssl rand -base64 32
OAUTH_STATE_SECRET=
