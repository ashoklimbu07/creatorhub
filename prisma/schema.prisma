generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum VideoStatus {
  DRAFT
  READY
  PUBLISHING
  PUBLISHED
  FAILED
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  FACEBOOK
}

enum Privacy {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PublishStatus {
  PENDING
  PUBLISHING
  SUCCESS
  FAILED
}

model User {
  id                 String     @id
  email              String     @unique
  name               String?
  avatarUrl          String?
  connectedPlatforms Platform[] @default([])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  videos              Video[]
  platformConnections PlatformConnection[]

  @@map("users")
}

model PlatformConnection {
  id                       String   @id @default(cuid())
  userId                   String
  platform                 Platform
  isDefault                Boolean  @default(false)
  accessToken              String
  refreshToken             String
  expiresAt                DateTime
  externalAccountId        String
  externalAccountName      String
  externalAccountThumbnail String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A platform (e.g. FACEBOOK) may have several connections per user (one
  // per Page), but the same external account can't be connected twice.
  @@unique([userId, platform, externalAccountId])
  @@index([userId])
  @@index([userId, platform])
  @@map("platform_connections")
}

model Video {
  id           String      @id @default(cuid())
  userId       String
  title        String
  description  String?
  fileUrl      String
  thumbnailUrl String?
  duration     Int?
  width        Int?
  height       Int?
  sizeBytes    BigInt?
  status       VideoStatus @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  draft            Draft?
  platformSettings PlatformSettings[]

  @@index([userId])
  @@map("videos")
}

model Draft {
  id           String   @id @default(cuid())
  videoId      String   @unique
  lastEditedAt DateTime @default(now())
  createdAt    DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("drafts")
}

model PlatformSettings {
  id              String        @id @default(cuid())
  videoId         String
  platform        Platform
  title           String
  caption         String?
  description     String?
  hashtags        String[]      @default([])
  containsAltered Boolean       @default(false)
  privacy         Privacy       @default(PUBLIC)
  scheduledAt     DateTime?
  publishStatus   PublishStatus @default(PENDING)
  publishedAt     DateTime?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, platform])
  @@index([videoId])
  @@map("platform_settings")
}
